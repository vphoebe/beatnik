{
  "name": "beatnik",
  "version": "5.0.0",
  "description": "modern and simple Discord music bot with easy-to-use commands",
  "author": "vphoebe",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && tsdown",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "knip": "knip",
    "lint": "npx eslint ./src",
    "lint:fix": "npx eslint ./src --fix",
    "typecheck": "tsc --noEmit",
    "dev:docker": "docker compose -f 'docker-compose.dev.yml' up --build --remove-orphans",
    "next:up": "docker compose -f 'docker-compose.next.yml' up --build --remove-orphans",
    "next:build": "docker build --target prod -t nickseman/beatnik:next .",
    "latest:build": "docker build --target prod -t nickseman/beatnik:latest ."
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^0.1.81",
    "better-sqlite3": "^12.8.0",
    "bgutils-js": "^3.2.0",
    "bufferutil": "^4.1.0",
    "discord.js": "^14.22.1",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "googlevideo": "^4.0.4",
    "jsdom": "^26.1.0",
    "youtubei.js": "^17.0.1",
    "zlib-sync": "^0.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.5.0",
    "eslint": "^9.33.0",
    "knip": "^5.62.0",
    "prettier": "^3.3.2",
    "tsdown": "^0.21.5",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.40.0"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@discordjs/opus",
      "better-sqlite3",
      "bufferutil",
      "esbuild",
      "ffmpeg-static",
      "zlib-sync"
    ]
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
