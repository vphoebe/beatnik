{
  "name": "beatnik",
  "version": "5.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "pnpm --filter @beatnik/core build",
    "dev": "pnpm --filter @beatnik/core dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm --filter @beatnik/core format",
    "dev:docker": "docker compose -f 'apps/beatnik/docker-compose.dev.yml' up --build --remove-orphans",
    "next:up": "docker compose -f 'apps/beatnik/docker-compose.next.yml' up --build --remove-orphans",
    "next:build": "docker build --target prod -t nickseman/beatnik:next .",
    "latest:build": "docker build --target prod -t nickseman/beatnik:latest ."
  },
  "keywords": [],
  "author": "me@vphoebe.dev",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^25.5.0",
    "eslint": "^9.33.0",
    "knip": "^5.62.0",
    "prettier": "^3.3.2",
    "tsdown": "^0.21.5",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.40.0"
  },
  "packageManager": "pnpm@10.33.0"
}
